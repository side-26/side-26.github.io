NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Optional upstream API configuration. Never prefix secrets with NEXT_PUBLIC_.
API_BASE_URL=https://api.example.com/v1/


# Server-only Gmail SMTP contact delivery configuration.
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
CONTACT_RECIPIENT_EMAIL=you@example.com

# Set this explicitly in production. Local development can use http://localhost:3000.
CONTACT_FORM_ALLOWED_ORIGIN=https://your-production-domain.com

# Optional bearer token for trusted server-to-server contact submissions.
CONTACT_MESSAGE_API_KEY=replace-with-a-long-random-secret
