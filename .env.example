NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Server-only upstream API configuration. Never prefix secrets with NEXT_PUBLIC_.
API_BASE_URL=https://api.example.com/v1/
API_BEARER_TOKEN=

# Private contact-message dispatcher. Call this API only from a trusted server.
CONTACT_MESSAGE_API_KEY=replace-with-a-long-random-secret
CONTACT_MESSAGE_WEBHOOK_TOKEN=replace-with-your-provider-token
CONTACT_EMAIL_WEBHOOK_URL=https://automation.example.com/hooks/contact-email
CONTACT_PHONE_WEBHOOK_URL=https://automation.example.com/hooks/contact-phone
CONTACT_TELEGRAM_WEBHOOK_URL=https://automation.example.com/hooks/contact-telegram
CONTACT_INSTAGRAM_WEBHOOK_URL=https://automation.example.com/hooks/contact-instagram
